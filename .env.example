# SUPABASE CONFIG (Obrigatório para o RAG e Logs)
SUPABASE_URL=sua_url_do_supabase
SUPABASE_KEY=sua_chave_anon_ou_service_role

# LLM CONFIG (Obrigatório para os Agentes CrewAI)
LLM_PROVIDER=gemini  # 'gemini' ou 'groq'

# GEMINI CONFIG
GEMINI_API_KEY=sua_chave_do_google_ai_studio
GEMINI_MODEL=gemini/gemini-1.5-flash

# GROQ CONFIG
GROQ_API_KEY=sua_chave_do_groq
GROQ_MODEL=groq/llama3-8b-8192

# OPENAI CONFIG
OPENAI_API_KEY=sua_chave_da_openai
OPENAI_MODEL=openai/gpt-4o-mini

# FLUXO DE EXECUCAO
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000

# SERVIDOR
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
